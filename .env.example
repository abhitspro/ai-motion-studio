# ==========================================
# API Keys & Configuration Template
# ==========================================

# 1. OpenAI API Key (Optional / Standard Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# 2. OpenAI Base URL (Set to standard or custom gateway)
OPENAI_BASE_URL=https://apinex.bond/v1

# 3. APInex API Key (Required for the video pipeline gateway)
# ----------------------------------------------------------
# How to get your APInex API Key:
#   - Visit the APInex dashboard at https://apinex.bond
#   - Log in or create your account.
#   - Navigate to the API Keys section in your user profile or settings.
#   - Generate a new key and copy it (format usually starts with "sk-apx...").
#   - Paste your key below:
APINEX_API_KEY=your_apinx_api_key_here